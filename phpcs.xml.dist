<?xml version="1.0"?>
<ruleset name="Neural Forms Lite">
    <description>Coding standards for Neural Forms Lite production code.</description>

    <!-- Scan PHP only. -->
    <arg name="extensions" value="php"/>

    <!-- Show progress + colors when run interactively. -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Default scan target: plugin root. -->
    <file>.</file>

    <!-- Dev-only directories — never shipped, never reviewed. -->
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/vendor-elicus/*</exclude-pattern>
    <exclude-pattern>*/docs/*</exclude-pattern>

    <!-- WordPress coding standard for production code. -->
    <rule ref="WordPress">
        <!-- Class-per-file naming conflicts with our PSR-4 autoloader.
             Files like includes/class-neuralforms.php hold a class
             named NeuralForms\NeuralForms — WPCS expects exactly
             "class-neural-forms.php" which we don't use. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <!-- Minimum-version targets, taken from the plugin header. -->
    <config name="testVersion" value="7.4-"/>
    <config name="minimum_supported_wp_version" value="6.8"/>

    <!-- Lock the i18n text domain so the I18n sniff doesn't second-guess us. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="neural-forms-lite"/>
            </property>
        </properties>
    </rule>

    <!-- Prefixes used for every global symbol the plugin exposes. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="neural_forms"/>
                <element value="NeuralForms"/>
                <element value="NEURAL_FORMS"/>
            </property>
        </properties>
    </rule>
</ruleset>
