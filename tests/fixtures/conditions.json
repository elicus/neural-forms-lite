{
  "_doc": "Shared condition-engine fixtures. Run by tests/ConditionEngineTest.php (PHP ConditionEngine) and tests/ConditionEngineTest.js (form-submit.js). `data` is the submitted value map as PHP sees it; the JS runner derives the DOM-visible string the same way getFieldValue() does (checkbox true/1 -> '1', arrays joined by ',', missing -> ''). Cases that rely on the PHP-only lenient fallback for an ABSENT non-choice controller are kept in ConditionalLogicOperatorsTest.php, not here. `expected` is: should the owner be visible?",
  "evaluate": [
    { "name": "legacy v1 equals match",        "logic": { "enabled": true, "field": "q", "operator": "equals", "value": "yes" }, "data": { "q": "yes" }, "types": { "q": "text" }, "expected": true },
    { "name": "legacy v1 equals miss",         "logic": { "enabled": true, "field": "q", "operator": "equals", "value": "yes" }, "data": { "q": "no" },  "types": { "q": "text" }, "expected": false },
    { "name": "legacy v1 not_equals",          "logic": { "enabled": true, "field": "q", "operator": "not_equals", "value": "no" }, "data": { "q": "yes" }, "types": { "q": "text" }, "expected": true },
    { "name": "legacy v1 contains",            "logic": { "enabled": true, "field": "q", "operator": "contains", "value": "world" }, "data": { "q": "hello world" }, "types": { "q": "text" }, "expected": true },
    { "name": "legacy v1 contains empty rule value never matches", "logic": { "enabled": true, "field": "q", "operator": "contains", "value": "" }, "data": { "q": "hello" }, "types": { "q": "text" }, "expected": false },
    { "name": "legacy v1 empty",               "logic": { "enabled": true, "field": "q", "operator": "empty", "value": "" }, "data": { "q": "  " }, "types": { "q": "text" }, "expected": true },
    { "name": "legacy v1 not_empty",           "logic": { "enabled": true, "field": "q", "operator": "not_empty", "value": "" }, "data": { "q": "x" }, "types": { "q": "text" }, "expected": true },
    { "name": "legacy v1 gte true",            "logic": { "enabled": true, "field": "n", "operator": "gte", "value": "5" }, "data": { "n": "5" }, "types": { "n": "number" }, "expected": true },
    { "name": "legacy v1 gte false",           "logic": { "enabled": true, "field": "n", "operator": "gte", "value": "5" }, "data": { "n": "4" }, "types": { "n": "number" }, "expected": false },
    { "name": "legacy v1 gte non-numeric control", "logic": { "enabled": true, "field": "n", "operator": "gte", "value": "5" }, "data": { "n": "abc" }, "types": { "n": "number" }, "expected": false },
    { "name": "legacy v1 gte non-numeric rule",    "logic": { "enabled": true, "field": "n", "operator": "gte", "value": "abc" }, "data": { "n": "5" }, "types": { "n": "number" }, "expected": false },
    { "name": "legacy v1 lte true",            "logic": { "enabled": true, "field": "n", "operator": "lte", "value": "5" }, "data": { "n": "-5" }, "types": { "n": "number" }, "expected": true },
    { "name": "legacy v1 lte false",           "logic": { "enabled": true, "field": "n", "operator": "lte", "value": "5" }, "data": { "n": "6" }, "types": { "n": "number" }, "expected": false },
    { "name": "legacy v1 float strings",       "logic": { "enabled": true, "field": "n", "operator": "gte", "value": "5" }, "data": { "n": "5.5" }, "types": { "n": "number" }, "expected": true },
    { "name": "legacy v1 unknown operator shows", "logic": { "enabled": true, "field": "q", "operator": "zzz", "value": "x" }, "data": { "q": "x" }, "types": { "q": "text" }, "expected": true },
    { "name": "checkbox ticked equals 1",      "logic": { "enabled": true, "field": "c", "operator": "equals", "value": "1" }, "data": { "c": "1" }, "types": { "c": "checkbox" }, "expected": true },
    { "name": "checkbox ticked (true) equals 1", "logic": { "enabled": true, "field": "c", "operator": "equals", "value": "1" }, "data": { "c": true }, "types": { "c": "checkbox" }, "expected": true },
    { "name": "checkbox unticked (0) equals 1", "logic": { "enabled": true, "field": "c", "operator": "equals", "value": "1" }, "data": { "c": "0" }, "types": { "c": "checkbox" }, "expected": false },
    { "name": "checkbox absent not_empty hides", "logic": { "enabled": true, "field": "c", "operator": "not_empty", "value": "" }, "data": {}, "types": { "c": "checkbox" }, "expected": false },
    { "name": "radio absent equals hides",     "logic": { "enabled": true, "field": "r", "operator": "equals", "value": "Yes" }, "data": {}, "types": { "r": "radio" }, "expected": false },
    { "name": "checkboxes contains one of selected", "logic": { "enabled": true, "field": "m", "operator": "contains", "value": "b" }, "data": { "m": ["a", "b"] }, "types": { "m": "checkboxes" }, "expected": true },
    { "name": "checkboxes contains none selected", "logic": { "enabled": true, "field": "m", "operator": "contains", "value": "z" }, "data": { "m": ["a", "b"] }, "types": { "m": "checkboxes" }, "expected": false },

    { "name": "v2 all: both match",            "logic": { "enabled": true, "version": 2, "action": "show", "match": "all", "rules": [ { "field": "service", "operator": "equals", "value": "web" }, { "field": "budget", "operator": "gte", "value": "5000" } ] }, "data": { "service": "web", "budget": "7000" }, "types": { "service": "select", "budget": "number" }, "expected": true },
    { "name": "v2 all: one fails",             "logic": { "enabled": true, "version": 2, "action": "show", "match": "all", "rules": [ { "field": "service", "operator": "equals", "value": "web" }, { "field": "budget", "operator": "gte", "value": "5000" } ] }, "data": { "service": "web", "budget": "100" }, "types": { "service": "select", "budget": "number" }, "expected": false },
    { "name": "v2 any: one matches",           "logic": { "enabled": true, "version": 2, "action": "show", "match": "any", "rules": [ { "field": "service", "operator": "equals", "value": "web" }, { "field": "budget", "operator": "gte", "value": "5000" } ] }, "data": { "service": "seo", "budget": "9000" }, "types": { "service": "select", "budget": "number" }, "expected": true },
    { "name": "v2 any: none match",            "logic": { "enabled": true, "version": 2, "action": "show", "match": "any", "rules": [ { "field": "service", "operator": "equals", "value": "web" }, { "field": "budget", "operator": "gte", "value": "5000" } ] }, "data": { "service": "seo", "budget": "100" }, "types": { "service": "select", "budget": "number" }, "expected": false },
    { "name": "v2 three rules all",            "logic": { "enabled": true, "version": 2, "match": "all", "rules": [ { "field": "a", "operator": "not_empty", "value": "" }, { "field": "b", "operator": "equals", "value": "1" }, { "field": "c", "operator": "lte", "value": "10" } ] }, "data": { "a": "x", "b": "1", "c": "3" }, "types": { "a": "text", "b": "checkbox", "c": "number" }, "expected": true },
    { "name": "v2 hide action: matched hides", "logic": { "enabled": true, "version": 2, "action": "hide", "match": "all", "rules": [ { "field": "country", "operator": "equals", "value": "US" } ] }, "data": { "country": "US" }, "types": { "country": "select" }, "expected": false },
    { "name": "v2 hide action: unmatched shows", "logic": { "enabled": true, "version": 2, "action": "hide", "match": "all", "rules": [ { "field": "country", "operator": "equals", "value": "US" } ] }, "data": { "country": "FR" }, "types": { "country": "select" }, "expected": true },
    { "name": "v2 hide + any",                 "logic": { "enabled": true, "version": 2, "action": "hide", "match": "any", "rules": [ { "field": "a", "operator": "equals", "value": "1" }, { "field": "b", "operator": "equals", "value": "1" } ] }, "data": { "a": "0", "b": "1" }, "types": { "a": "checkbox", "b": "checkbox" }, "expected": false },
    { "name": "v2 rules without field are ignored", "logic": { "enabled": true, "version": 2, "match": "all", "rules": [ { "field": "", "operator": "equals", "value": "x" }, { "field": "a", "operator": "equals", "value": "1" } ] }, "data": { "a": "1" }, "types": { "a": "text" }, "expected": true },
    { "name": "v2 unknown match falls back to all", "logic": { "enabled": true, "version": 2, "match": "weird", "rules": [ { "field": "a", "operator": "equals", "value": "1" }, { "field": "b", "operator": "equals", "value": "1" } ] }, "data": { "a": "1", "b": "0" }, "types": { "a": "text", "b": "text" }, "expected": false },
    { "name": "v2 unknown action falls back to show", "logic": { "enabled": true, "version": 2, "action": "weird", "rules": [ { "field": "a", "operator": "equals", "value": "1" } ] }, "data": { "a": "1" }, "types": { "a": "text" }, "expected": true },

    { "name": "pro A and (B or C): B true",    "logic": { "enabled": true, "version": 2, "match": "all", "rules": [ { "field": "a", "operator": "equals", "value": "1" } ], "groups": [ { "match": "any", "rules": [ { "field": "b", "operator": "equals", "value": "1" }, { "field": "c", "operator": "equals", "value": "1" } ] } ] }, "data": { "a": "1", "b": "1", "c": "0" }, "types": { "a": "text", "b": "text", "c": "text" }, "expected": true },
    { "name": "pro A and (B or C): neither",   "logic": { "enabled": true, "version": 2, "match": "all", "rules": [ { "field": "a", "operator": "equals", "value": "1" } ], "groups": [ { "match": "any", "rules": [ { "field": "b", "operator": "equals", "value": "1" }, { "field": "c", "operator": "equals", "value": "1" } ] } ] }, "data": { "a": "1", "b": "0", "c": "0" }, "types": { "a": "text", "b": "text", "c": "text" }, "expected": false },
    { "name": "pro A and (B or C): A false",   "logic": { "enabled": true, "version": 2, "match": "all", "rules": [ { "field": "a", "operator": "equals", "value": "1" } ], "groups": [ { "match": "any", "rules": [ { "field": "b", "operator": "equals", "value": "1" }, { "field": "c", "operator": "equals", "value": "1" } ] } ] }, "data": { "a": "0", "b": "1", "c": "1" }, "types": { "a": "text", "b": "text", "c": "text" }, "expected": false },
    { "name": "pro (A and B) or (C and D)",    "logic": { "enabled": true, "version": 2, "match": "any", "rules": [], "groups": [ { "match": "all", "rules": [ { "field": "a", "operator": "equals", "value": "1" }, { "field": "b", "operator": "equals", "value": "1" } ] }, { "match": "all", "rules": [ { "field": "c", "operator": "equals", "value": "1" }, { "field": "d", "operator": "equals", "value": "1" } ] } ] }, "data": { "a": "0", "b": "1", "c": "1", "d": "1" }, "types": { "a": "text", "b": "text", "c": "text", "d": "text" }, "expected": true },
    { "name": "pro empty group is dropped",    "logic": { "enabled": true, "version": 2, "match": "all", "rules": [ { "field": "a", "operator": "equals", "value": "1" } ], "groups": [ { "match": "any", "rules": [] } ] }, "data": { "a": "1" }, "types": { "a": "text" }, "expected": true }
  ],
  "resolve": [
    {
      "name": "controller hidden hides dependent even if dependent rule would pass",
      "fields": [
        { "id": "a", "type": "radio" },
        { "id": "b", "type": "text", "conditional_logic": { "enabled": true, "field": "a", "operator": "equals", "value": "yes" } },
        { "id": "c", "type": "text", "conditional_logic": { "enabled": true, "version": 2, "match": "all", "rules": [ { "field": "b", "operator": "empty", "value": "" } ] } }
      ],
      "data": { "a": "no", "b": "" },
      "expected_hidden": [ "b", "c" ]
    },
    {
      "name": "any-match survives one hidden controller",
      "fields": [
        { "id": "a", "type": "radio" },
        { "id": "b", "type": "text", "conditional_logic": { "enabled": true, "field": "a", "operator": "equals", "value": "yes" } },
        { "id": "d", "type": "text" },
        { "id": "c", "type": "text", "conditional_logic": { "enabled": true, "version": 2, "match": "any", "rules": [ { "field": "b", "operator": "not_empty", "value": "" }, { "field": "d", "operator": "not_empty", "value": "" } ] } }
      ],
      "data": { "a": "no", "b": "", "d": "x" },
      "expected_hidden": [ "b" ]
    },
    {
      "name": "disabled logic is ignored",
      "fields": [
        { "id": "a", "type": "text" },
        { "id": "b", "type": "text", "conditional_logic": { "enabled": false, "field": "a", "operator": "equals", "value": "yes" } }
      ],
      "data": { "a": "no" },
      "expected_hidden": []
    },
    {
      "name": "hide action on controller match",
      "fields": [
        { "id": "country", "type": "select" },
        { "id": "state", "type": "text", "conditional_logic": { "enabled": true, "version": 2, "action": "hide", "rules": [ { "field": "country", "operator": "not_equals", "value": "US" } ] } }
      ],
      "data": { "country": "FR" },
      "expected_hidden": [ "state" ]
    }
  ]
}
