    {
        "name": "visitor-entered amount clamped to min/max; calculated fields chain and use if()",
        "config": {
            "currency": "GBP",
            "exponent": 2,
            "symbol": "£",
            "products": [
                {
                    "id": "gift",
                    "label": "Donation",
                    "mode": "input",
                    "display": "select",
                    "price": 0,
                    "quantity": {
                        "enabled": false,
                        "min": 1,
                        "max": 10,
                        "default": 1
                    },
                    "min": 500,
                    "max": 50000,
                    "options": []
                }
            ],
            "calculated": [
                {
                    "id": "per_head",
                    "expression": "if({guests} > 10, 15, 20)",
                    "format": "number",
                    "decimals": 0
                },
                {
                    "id": "catering",
                    "expression": "round({guests} * {per_head}, 2)",
                    "format": "currency",
                    "decimals": 2
                }
            ],
            "discounts": [],
            "deposit": null
        }
    },
