{
	"id": "contact-us-1",
	"name": "Contact Us",
	"builder": "block-editor",
	"type": "form",
	"version": "1.0.0",
	"form": {
		"title": "Contact Us",
		"description": "",
		"fields": [
			{
				"id": "name",
				"type": "text",
				"label": "Name",
				"placeholder": "Your full name",
				"required": true,
				"width": "full"
			},
			{
				"id": "email",
				"type": "email",
				"label": "Email",
				"placeholder": "you@example.com",
				"required": true,
				"width": "full"
			},
			{
				"id": "subject",
				"type": "text",
				"label": "Subject",
				"placeholder": "What's this about?",
				"required": false,
				"width": "full"
			},
			{
				"id": "message",
				"type": "textarea",
				"label": "Message",
				"placeholder": "Tell us a bit more…",
				"required": true,
				"width": "full",
				"rows": 5
			}
		],
		"settings": {
			"success_message": "Thanks — we'll get back to you soon.",
			"error_message": "Sorry, something went wrong. Please try again.",
			"submit_button_text": "Send Message"
		}
	}
}
