{
  "name": "neural-forms-lite-admin",
  "version": "1.0.0",
  "private": true,
  "description": "React admin bundle for Neural Forms Lite. Outputs to modules/admin/build/ and is enqueued by AdminPanel.php.",
  "license": "GPL-2.0-or-later",
  "author": "Elicus",
  "scripts": {
    "build": "node -e \"console.error('ERROR: Do not run npm run build for Neural Forms admin. Full admin source parity is not restored. Use npm run build:builder instead.'); process.exit(1);\"",
    "build:full:unsafe": "wp-scripts build --webpack-src-dir=src --output-path=build",
    "start": "wp-scripts start --webpack-src-dir=src --output-path=build",
    "build:builder": "wp-scripts build --config webpack.split.config.js --env screen=builder",
    "build:results": "wp-scripts build --config webpack.split.config.js --env screen=results",
    "build:blocks-extra": "wp-scripts build --config webpack.split.config.js --env screen=blocks-extra",
    "build:forms": "wp-scripts build --config webpack.split.config.js --env screen=forms",
    "build:entries": "wp-scripts build --config webpack.split.config.js --env screen=entries",
    "build:settings": "wp-scripts build --config webpack.split.config.js --env screen=settings",
    "build:stats": "wp-scripts build --config webpack.split.config.js --env screen=stats",
    "build:admin-shell": "wp-scripts build --config webpack.split.config.js --env screen=admin-shell",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style \"src/**/*.css\"",
    "format": "wp-scripts format src"
  },
  "devDependencies": {
    "@wordpress/scripts": "26.19.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2"
  },
  "overrides": {
    "json-parse-even-better-errors": "3.0.0",
    "parse-json": "5.2.0",
    "@npmcli/fs": "2.1.2",
    "cacache": "16.1.3",
    "minipass": "3.3.6",
    "fs-minipass": "2.1.0",
    "minipass-fetch": "1.4.1",
    "tar": "6.1.11"
  }
}
