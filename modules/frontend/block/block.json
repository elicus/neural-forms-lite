{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "neural-forms/form",
    "version": "0.1.0",
    "title": "Neural Forms Form",
    "category": "embed",
    "description": "Embed a Neural Forms form on any post or page.",
    "keywords": [ "form", "contact", "submission" ],
    "textdomain": "neural-forms-lite",

    "attributes": {
        "formId":       { "type": "integer" },

        "formAlign":    { "type": "string",  "default": "" },
        "formWidth":    { "type": "string",  "default": "" },
        "maxWidth":     { "type": "string",  "default": "" },
        "minHeight":    { "type": "string",  "default": "" },
        "height":       { "type": "string",  "default": "" },
        "maxHeight":    { "type": "string",  "default": "" },
        "marginTop":    { "type": "string",  "default": "" },
        "marginRight":  { "type": "string",  "default": "" },
        "marginBottom": { "type": "string",  "default": "" },
        "marginLeft":   { "type": "string",  "default": "" },
        "paddingTop":   { "type": "string",  "default": "" },
        "paddingRight": { "type": "string",  "default": "" },
        "paddingBottom":{ "type": "string",  "default": "" },
        "paddingLeft":  { "type": "string",  "default": "" },

        "bgColor":         { "type": "string",  "default": "" },
        "bgGradient":      { "type": "string",  "default": "" },
        "bgImage":         { "type": "string",  "default": "" },
        "bgImageSize":     { "type": "string",  "default": "" },
        "bgImagePosition": { "type": "string",  "default": "" },
        "bgImageRepeat":   { "type": "string",  "default": "" },

        "borderColor":  { "type": "string",  "default": "" },
        "borderWidth":  { "type": "string",  "default": "" },
        "borderStyle":  { "type": "string",  "default": "" },
        "borderRadius": { "type": "string",  "default": "" },
        "borderRadiusTL": { "type": "string", "default": "" },
        "borderRadiusTR": { "type": "string", "default": "" },
        "borderRadiusBR": { "type": "string", "default": "" },
        "borderRadiusBL": { "type": "string", "default": "" },

        "btnTextColor": { "type": "string",  "default": "" },
        "btnBgColor":   { "type": "string",  "default": "" },

        "btnAlign":     { "type": "string",  "default": "" },
        "btnFullWidth": { "type": "boolean", "default": false },
        "btnRadius":    { "type": "string",  "default": "" },
        "btnRadiusTL":  { "type": "string",  "default": "" },
        "btnRadiusTR":  { "type": "string",  "default": "" },
        "btnRadiusBR":  { "type": "string",  "default": "" },
        "btnRadiusBL":  { "type": "string",  "default": "" },
        "btnBorderColor": { "type": "string", "default": "" },
        "btnBorderWidth": { "type": "string", "default": "" },
        "btnBorderStyle": { "type": "string", "default": "" },
        "btnFontSize":    { "type": "string", "default": "" },
        "btnFontFamily":  { "type": "string", "default": "" },
        "btnFontWeight":      { "type": "string", "default": "" },
        "btnLetterSpacing":   { "type": "string", "default": "" },
        "btnTextDecoration":  { "type": "string", "default": "" },
        "btnTextTransform":   { "type": "string", "default": "" },
        "btnLineHeight":      { "type": "string", "default": "" },
        "btnPaddingTop":    { "type": "string", "default": "" },
        "btnPaddingRight":  { "type": "string", "default": "" },
        "btnPaddingBottom": { "type": "string", "default": "" },
        "btnPaddingLeft":   { "type": "string", "default": "" },
        "btnHoverBg":          { "type": "string", "default": "" },
        "btnHoverColor":       { "type": "string", "default": "" },
        "btnHoverBorderColor": { "type": "string", "default": "" },
        "btnTransitionDuration": { "type": "string", "default": "" },
        "btnTransitionEasing":   { "type": "string", "default": "" },

        "shadowH":               { "type": "string",  "default": "" },
        "shadowV":               { "type": "string",  "default": "" },
        "shadowBlur":            { "type": "string",  "default": "" },
        "shadowSpread":          { "type": "string",  "default": "" },
        "shadowColor":           { "type": "string",  "default": "" },
        "shadowPosition":        { "type": "string",  "default": "" },

        "fieldBg":               { "type": "string",  "default": "" },
        "fieldFocusBg":          { "type": "string",  "default": "" },
        "fieldHoverBg":          { "type": "string",  "default": "" },
        "fieldHoverBorderColor": { "type": "string",  "default": "" },
        "fieldBorderColor":      { "type": "string",  "default": "" },
        "fieldBorderWidth":      { "type": "string",  "default": "" },
        "fieldBorderStyle":      { "type": "string",  "default": "" },
        "fieldBorderRadius":     { "type": "string",  "default": "" },
        "fieldBorderRadiusTL":   { "type": "string",  "default": "" },
        "fieldBorderRadiusTR":   { "type": "string",  "default": "" },
        "fieldBorderRadiusBR":   { "type": "string",  "default": "" },
        "fieldBorderRadiusBL":   { "type": "string",  "default": "" },
        "fieldTextColor":        { "type": "string",  "default": "" },
        "fieldFocusTextColor":   { "type": "string",  "default": "" },
        "fieldFocusBorderColor": { "type": "string",  "default": "" },
        "fieldFontSize":         { "type": "string",  "default": "" },
        "fieldFontFamily":       { "type": "string",  "default": "" },
        "fieldFontWeight":       { "type": "string",  "default": "" },
        "fieldLetterSpacing":    { "type": "string",  "default": "" },
        "fieldTextDecoration":   { "type": "string",  "default": "" },
        "fieldTextTransform":    { "type": "string",  "default": "" },
        "fieldLineHeight":       { "type": "string",  "default": "" },
        "fieldTextAlign":        { "type": "string",  "default": "" },
        "fieldPaddingTop":        { "type": "string", "default": "" },
        "fieldPaddingRight":      { "type": "string", "default": "" },
        "fieldPaddingBottom":     { "type": "string", "default": "" },
        "fieldPaddingLeft":       { "type": "string", "default": "" },
        "fieldGap":              { "type": "string",  "default": "" },

        "fieldErrorBg":          { "type": "string",  "default": "" },
        "fieldErrorTextColor":   { "type": "string",  "default": "" },
        "fieldErrorBorderColor": { "type": "string",  "default": "" },
        "fieldErrorMsgColor":    { "type": "string",  "default": "" },
        "fieldErrorMsgFontSize": { "type": "string",  "default": "" },

        "successMsgEnabled":     { "type": "boolean", "default": true },
        "successMsgBg":          { "type": "string",  "default": "" },
        "successMsgColor":       { "type": "string",  "default": "" },
        "successMsgBorderColor": { "type": "string",  "default": "" },
        "successMsgPaddingTop":    { "type": "string", "default": "" },
        "successMsgPaddingRight":  { "type": "string", "default": "" },
        "successMsgPaddingBottom": { "type": "string", "default": "" },
        "successMsgPaddingLeft":   { "type": "string", "default": "" },

        "errorMsgEnabled":       { "type": "boolean", "default": true },
        "errorMsgBg":            { "type": "string",  "default": "" },
        "errorMsgColor":         { "type": "string",  "default": "" },
        "errorMsgBorderColor":   { "type": "string",  "default": "" },
        "errorMsgPaddingTop":    { "type": "string", "default": "" },
        "errorMsgPaddingRight":  { "type": "string", "default": "" },
        "errorMsgPaddingBottom": { "type": "string", "default": "" },
        "errorMsgPaddingLeft":   { "type": "string", "default": "" },

        "checkboxSize":          { "type": "string",  "default": "" },
        "checkboxCheckedColor":  { "type": "string",  "default": "" },
        "selectArrowColor":      { "type": "string",  "default": "" },
        "fileBg":                { "type": "string",  "default": "" },
        "fileColor":             { "type": "string",  "default": "" },
        "fileBorderColor":       { "type": "string",  "default": "" },

        "formTitle":             { "type": "string",  "default": "" },
        "titleLevel":            { "type": "string",  "default": "h2" },
        "titleAlign":            { "type": "string",  "default": "" },
        "titleColor":            { "type": "string",  "default": "" },
        "titleFontFamily":       { "type": "string",  "default": "" },
        "titleFontSize":         { "type": "string",  "default": "" },
        "titleFontWeight":       { "type": "string",  "default": "" },
        "titleLetterSpacing":    { "type": "string",  "default": "" },
        "titleTextDecoration":   { "type": "string",  "default": "" },
        "titleTextTransform":    { "type": "string",  "default": "" },
        "titleLineHeight":       { "type": "string",  "default": "" },
        "titlePaddingTop":       { "type": "string",  "default": "" },
        "titlePaddingRight":     { "type": "string",  "default": "" },
        "titlePaddingBottom":    { "type": "string",  "default": "" },
        "titlePaddingLeft":      { "type": "string",  "default": "" },
        "titleMarginTop":        { "type": "string",  "default": "" },
        "titleMarginRight":      { "type": "string",  "default": "" },
        "titleMarginBottom":     { "type": "string",  "default": "" },
        "titleMarginLeft":       { "type": "string",  "default": "" },

        "showLabels":            { "type": "boolean", "default": false },
        "showPlaceholders":      { "type": "boolean", "default": true  },
        "labelAlign":            { "type": "string",  "default": "" },
        "labelColor":            { "type": "string",  "default": "" },
        "labelFontFamily":       { "type": "string",  "default": "" },
        "labelFontSize":         { "type": "string",  "default": "" },
        "labelFontWeight":       { "type": "string",  "default": "" },
        "labelLetterSpacing":    { "type": "string",  "default": "" },
        "labelTextDecoration":   { "type": "string",  "default": "" },
        "labelTextTransform":    { "type": "string",  "default": "" },
        "labelLineHeight":       { "type": "string",  "default": "" },
        "labelPaddingTop":       { "type": "string",  "default": "" },
        "labelPaddingRight":     { "type": "string",  "default": "" },
        "labelPaddingBottom":    { "type": "string",  "default": "" },
        "labelPaddingLeft":      { "type": "string",  "default": "" },
        "labelMarginTop":        { "type": "string",  "default": "" },
        "labelMarginRight":      { "type": "string",  "default": "" },
        "labelMarginBottom":     { "type": "string",  "default": "" },
        "labelMarginLeft":       { "type": "string",  "default": "" },

        "extraClass":            { "type": "string",  "default": "" }
    },

    "editorScript": "neural-forms-block",

    "supports": {
        "html": false,
        "className": false,
        "customClassName": false
    }
}
